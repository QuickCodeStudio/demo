# Local secrets for Docker Compose and dotnet run (copy to .env — never commit .env)
#
# Image storage (BLOB_IMAGE): non-secret defaults are filled below.
# Secret keys (AZURE_ACCOUNT_KEY, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) are intentionally empty.
# If you want local uploads, fill those yourself — regenerate will overwrite .env.
#
# RSA key pair (base64 DER). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER | openssl base64 -A   # -> private (PKCS#8)
#   (derive the SPKI public key from the private key and base64-encode it)
# Only the Gateway gets the private key; modules only get the public key.
GATEWAY_JWT_PRIVATE_KEY=replace-with-base64-pkcs8-private-key
GATEWAY_JWT_PUBLIC_KEY=replace-with-base64-spki-public-key
GATEWAY_INTERNAL_TOKEN_KEY=replace-with-long-random-internal-token-key
# RSA private key for user JWTs (RS256, base64 PKCS#8). Only the Identity module uses it.
USER_JWT_PRIVATE_KEY=replace-with-base64-pkcs8-private-key

PGSQL_PORT=5432
MYSQL_PORT=3306
SQL_PORT=5433
ELASTIC_PORT=9200
KIBANA_PORT=5601
EVENT_LISTENER_PORT=6100
KAFDROP_PORT=9000
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181
GATEWAY_PORT=6060
PORTAL_PORT=6020

# Image upload provider: azure | r2 | minio | local
BLOB_PROVIDER=azure
AZURE_ACCOUNT_NAME=quickcodeblobstorage
AZURE_ACCOUNT_KEY=
AZURE_BLOB_CONTAINER_NAME=images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quickcode-images
R2_PUBLIC_BASE_URL=
# Per-project folder, e.g. freytz → https://images.example.com/freytz/{guid}.png
R2_KEY_PREFIX=
# MinIO / S3 (when BLOB_PROVIDER=minio)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=quickcode-images
S3_PUBLIC_BASE_URL=
# Local disk (when BLOB_PROVIDER=local)
LOCAL_PUBLIC_BASE_URL=/uploads
