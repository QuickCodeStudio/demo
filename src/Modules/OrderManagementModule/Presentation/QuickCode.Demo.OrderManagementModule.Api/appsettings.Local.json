{
  "ConnectionStrings": {
    "ReadConnectionString": "Data Source=quickcode-sql-data;Initial Catalog=demo__order_management;User ID=SA;Password=Pass@word;TrustServerCertificate=True;",
    "WriteConnectionString": "Data Source=quickcode-sql-data;Initial Catalog=demo__order_management;User ID=SA;Password=Pass@word;TrustServerCertificate=True;"
  },
  "QuickcodeClients": {
    "FinanceSettlementModuleApi": "http://quickcode-demo-finance-settlement-api/",
    "PricingEngineModuleApi": "http://quickcode-demo-pricing-engine-api/",
    "ProductCatalogModuleApi": "http://quickcode-demo-product-catalog-api/",
    "SellerManagementModuleApi": "http://quickcode-demo-seller-management-api/",
    "IdentityModuleApi": "http://quickcode-demo-identity-api/"
  },
  "EmailService": {
    "BaseUrl": "https://api.quickcode.net/",
    "SendPath": "api/Email/send-from-template",
    "ProjectKey": "demo",
    "PortalUrl": "http://localhost:6220",
    "ApiKey": ""
  },
  "QuickcodeApiKeys": {
    "EmailSenderModuleApiKey": ""
  },
  "GatewayServiceTokenSettings": {
    "Issuer": "quickcode-gateway",
    "ExpirationSeconds": 60
  },
  "Kafka": {
	"BootstrapServers": "quickcode-kafka:9092",
	"GroupId": "demo-workflow-group"
  },
  "JwtSettings": {},
  "CorsSettings": {
    "AllowOrigins": [ "http://localhost:3000", "http://localhost:6260", "http://quickcode-demo-gateway-api", "https://*.quickcode.net", "https://*.europe-west1.run.app" ]
  },
  "AppSettings": {
    "ModuleName": "OrderManagementModule",
        "UseHealthCheck": "true",
    "DatabaseType": "mssql",
    "InMemoryDbName": "OrderManagementModuleDb",
    "HealthCheckSeconds": "10"
  },
  "Logging": {
    "ApiName": "quickcode-demo-ordermanagementmodule-api",
    "ElasticConfiguration": {
        "Uri": "http://quickcode-elasticsearch:9200"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Information"
      }
    }
  },
  "Auditing": {
    "CaptureFullEntityOnUpdate": true,
    "CaptureFullEntityOnInsert": true,
    "CaptureFullEntityOnDelete": true
  },
  "AllowedHosts": "*"
}