@using QuickCode.Demo.Portal.Models.FinanceSettlementModule
@using QuickCode.Demo.Portal.Helpers
@inject IPortalPagePermissionManager PortalPagePermissions
@model FinanceSettlementModule.PayoutReportData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex };
    var areaName = ViewContext.RouteData.Values["Area"]?.ToString() ?? string.Empty;
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    var ops = await PortalPagePermissions.GetPagePermission($"{areaName}{controllerName}", actionName);
}
@if (Model.List.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        No Data available in FinanceSettlementModule.PayoutReport table.
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    @PortalOperationButtonsHtml.Cell(ops, "Header", areaName, controllerName)
                    <th class="portal-col" data-col-type="id" data-col-key="Id">ID</th>
<th class="portal-col" data-col-type="fk" data-col-key="PayoutPeriodId">Payout Period ID</th>
<th class="portal-col" data-col-type="int" data-col-key="TotalSellers">Total Sellers</th>
<th class="portal-col" data-col-type="int" data-col-key="TotalPayouts">Total Payouts</th>
<th class="portal-col" data-col-type="money" data-col-key="TotalAmount">Total Amount</th>
<th class="portal-col" data-col-type="int" data-col-key="SuccessfulPayouts">Successful Payouts</th>
<th class="portal-col" data-col-type="int" data-col-key="FailedPayouts">Failed Payouts</th>
<th class="portal-col" data-col-type="int" data-col-key="PendingPayouts">Pending Payouts</th>
<th class="portal-col" data-col-type="datetime" data-col-key="GeneratedDate">Generated Date</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        @PortalOperationButtonsHtml.Cell(ops, item.GetKey(), areaName, controllerName)
                        <td class="portal-col" data-col-type="id" data-col-key="Id">@item.Id</td>
<td class="portal-col" data-col-type="fk" data-col-key="PayoutPeriodId">			@string.Format("{0}", Model.GetComboBoxValue("PayoutPeriods", item.PayoutPeriodId))</td>
<td class="portal-col" data-col-type="int" data-col-key="TotalSellers">@(((object)item.TotalSellers).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="int" data-col-key="TotalPayouts">@(((object)item.TotalPayouts).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="money" data-col-key="TotalAmount">@(((object)item.TotalAmount).ToPortalGridMoney())</td>
<td class="portal-col" data-col-type="int" data-col-key="SuccessfulPayouts">@(((object)item.SuccessfulPayouts).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="int" data-col-key="FailedPayouts">@(((object)item.FailedPayouts).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="int" data-col-key="PendingPayouts">@(((object)item.PendingPayouts).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="datetime" data-col-key="GeneratedDate">@(((object)item.GeneratedDate).ToPortalGridDateTime())</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
