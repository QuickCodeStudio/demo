@using QuickCode.Demo.Portal.Models.FinanceSettlementModule
@using QuickCode.Demo.Portal.Helpers
@inject IPortalPagePermissionManager PortalPagePermissions
@model FinanceSettlementModule.PayoutLineItemData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex };
    var areaName = ViewContext.RouteData.Values["Area"]?.ToString() ?? string.Empty;
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    var ops = await PortalPagePermissions.GetPagePermission($"{areaName}{controllerName}", actionName);
}
@if (Model.List.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        No Data available in FinanceSettlementModule.PayoutLineItem table.
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    @PortalOperationButtonsHtml.Cell(ops, "Header", areaName, controllerName)
                    <th class="portal-col" data-col-type="id" data-col-key="Id">ID</th>
<th class="portal-col" data-col-type="fk" data-col-key="PayoutId">Payout ID</th>
<th class="portal-col" data-col-type="int" data-col-key="OrderId">Order ID</th>
<th class="portal-col" data-col-type="int" data-col-key="OrderItemId">Order Item ID</th>
<th class="portal-col" data-col-type="money" data-col-key="ItemAmount">Item Amount</th>
<th class="portal-col" data-col-type="money" data-col-key="CommissionAmount">Commission Amount</th>
<th class="portal-col" data-col-type="money" data-col-key="AdjustmentAmount">Adjustment Amount</th>
<th class="portal-col" data-col-type="money" data-col-key="NetAmount">Net Amount</th>
<th class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">Created Date</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        @PortalOperationButtonsHtml.Cell(ops, item.GetKey(), areaName, controllerName)
                        <td class="portal-col" data-col-type="id" data-col-key="Id">@item.Id</td>
<td class="portal-col" data-col-type="fk" data-col-key="PayoutId">			@string.Format("{0}", Model.GetComboBoxValue("SellerPayouts", item.PayoutId))</td>
<td class="portal-col" data-col-type="int" data-col-key="OrderId">@(((object)item.OrderId).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="int" data-col-key="OrderItemId">@(((object)item.OrderItemId).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="money" data-col-key="ItemAmount">@(((object)item.ItemAmount).ToPortalGridMoney())</td>
<td class="portal-col" data-col-type="money" data-col-key="CommissionAmount">@(((object)item.CommissionAmount).ToPortalGridMoney())</td>
<td class="portal-col" data-col-type="money" data-col-key="AdjustmentAmount">@(((object)item.AdjustmentAmount).ToPortalGridMoney())</td>
<td class="portal-col" data-col-type="money" data-col-key="NetAmount">@(((object)item.NetAmount).ToPortalGridMoney())</td>
<td class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">@(((object)item.CreatedDate).ToPortalGridDateTime())</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
