@using QuickCode.Demo.Portal.Models.FinanceSettlementModule
@using QuickCode.Demo.Portal.Helpers
@inject IPortalPagePermissionManager PortalPagePermissions
@model FinanceSettlementModule.SellerPayoutData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex };
    var areaName = ViewContext.RouteData.Values["Area"]?.ToString() ?? string.Empty;
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    var ops = await PortalPagePermissions.GetPagePermission($"{areaName}{controllerName}", actionName);
}
@if (Model.List.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        No Data available in FinanceSettlementModule.SellerPayout table.
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    @PortalOperationButtonsHtml.Cell(ops, "Header", areaName, controllerName)
                    <th class="portal-col" data-col-type="id" data-col-key="Id">ID</th>
<th class="portal-col" data-col-type="int" data-col-key="SellerId">Seller ID</th>
<th class="portal-col" data-col-type="fk" data-col-key="PayoutPeriodId">Payout Period ID</th>
<th class="portal-col" data-col-type="money" data-col-key="TotalEarnings">Total Earnings</th>
<th class="portal-col" data-col-type="money" data-col-key="TotalCommission">Total Commission</th>
<th class="portal-col" data-col-type="money" data-col-key="TotalAdjustments">Total Adjustments</th>
<th class="portal-col" data-col-type="money" data-col-key="NetPayoutAmount">Net Payout Amount</th>
<th class="portal-col" data-col-type="text" data-col-key="Status">Status</th>
<th class="portal-col" data-col-type="datetime" data-col-key="RequestedDate">Requested Date</th>
<th class="portal-col" data-col-type="datetime" data-col-key="ApprovedDate">Approved Date</th>
<th class="portal-col" data-col-type="datetime" data-col-key="ProcessedDate">Processed Date</th>
<th class="portal-col" data-col-type="datetime" data-col-key="PaidDate">Paid Date</th>
<th class="portal-col" data-col-type="short" data-col-key="TransactionId">Transaction ID</th>
<th class="portal-col" data-col-type="large" data-col-key="Notes">Notes</th>
<th class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">Created Date</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        @PortalOperationButtonsHtml.Cell(ops, item.GetKey(), areaName, controllerName)
                        <td class="portal-col" data-col-type="id" data-col-key="Id">@item.Id</td>
<td class="portal-col" data-col-type="int" data-col-key="SellerId">@(((object)item.SellerId).ToPortalGridInt())</td>
<td class="portal-col" data-col-type="fk" data-col-key="PayoutPeriodId">			@string.Format("{0}", Model.GetComboBoxValue("PayoutPeriods", item.PayoutPeriodId))</td>
<td class="portal-col" data-col-type="money" data-col-key="TotalEarnings">@(((object)item.TotalEarnings).ToPortalGridMoney())</td>
<td class="portal-col" data-col-type="money" data-col-key="TotalCommission">@(((object)item.TotalCommission).ToPortalGridMoney())</td>
<td class="portal-col" data-col-type="money" data-col-key="TotalAdjustments">@(((object)item.TotalAdjustments).ToPortalGridMoney())</td>
<td class="portal-col" data-col-type="money" data-col-key="NetPayoutAmount">@(((object)item.NetPayoutAmount).ToPortalGridMoney())</td>
<td class="portal-col" data-col-type="text" data-col-key="Status">@item.Status</td>
<td class="portal-col" data-col-type="datetime" data-col-key="RequestedDate">@(((object)item.RequestedDate).ToPortalGridDateTime())</td>
<td class="portal-col" data-col-type="datetime" data-col-key="ApprovedDate">@(((object)item.ApprovedDate).ToPortalGridDateTime())</td>
<td class="portal-col" data-col-type="datetime" data-col-key="ProcessedDate">@(((object)item.ProcessedDate).ToPortalGridDateTime())</td>
<td class="portal-col" data-col-type="datetime" data-col-key="PaidDate">@(((object)item.PaidDate).ToPortalGridDateTime())</td>
<td class="portal-col" data-col-type="short" data-col-key="TransactionId">@item.TransactionId</td>
<td class="portal-col" data-col-type="large" data-col-key="Notes">@item.Notes</td>
<td class="portal-col" data-col-type="datetime" data-col-key="CreatedDate">@(((object)item.CreatedDate).ToPortalGridDateTime())</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
