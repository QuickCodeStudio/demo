@using QuickCode.Demo.Portal.Models.ProductCatalogModule
@using QuickCode.Demo.Portal.Helpers
@inject IPortalPagePermissionManager PortalPagePermissions
@model ProductCatalogModule.BrandData
@{
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex };
    var areaName = ViewContext.RouteData.Values["Area"]?.ToString() ?? string.Empty;
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    var ops = await PortalPagePermissions.GetPagePermission($"{areaName}{controllerName}", actionName);
}
@if (Model.List.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        No Data available in ProductCatalogModule.Brand table.
    </div>
}
else
{
    <vc:pager pager-data=pagerData></vc:pager>
    <div class="table-responsive portal-table-scroll">
        <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
            <thead bc-theme="Dark">
                <tr>
                    @PortalOperationButtonsHtml.Cell(ops, "Header", areaName, controllerName)
                    <th class="portal-col" data-col-type="id" data-col-key="Id">ID</th>
<th class="portal-col" data-col-type="text" data-col-key="Name">Name</th>
<th class="portal-col" data-col-type="thumb" data-col-key="Logo">Logo</th>
<th class="portal-col" data-col-type="thumb" data-col-key="Photo">Photo</th>
<th class="portal-col" data-col-type="file" data-col-key="BrandVideo">Brand Video</th>
<th class="portal-col" data-col-type="file" data-col-key="CatalogPdf">Catalog PDF</th>
<th class="portal-col" data-col-type="bool" data-col-key="IsActive">Is Active</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.List)
                {
                    <tr>
                        @PortalOperationButtonsHtml.Cell(ops, item.GetKey(), areaName, controllerName)
                        <td class="portal-col" data-col-type="id" data-col-key="Id">@item.Id</td>
<td class="portal-col" data-col-type="text" data-col-key="Name">@item.Name</td>
<td class="portal-col" data-col-type="thumb" data-col-key="Logo"><a href="@(item.Logo == null || item.Logo.Length == 0 ? "/images/no_image.png" : item.Logo)" data-toggle="lightbox" data-type="image" class="portal-list-thumb-link">
   <img class="lazyload img-fluid" src="/images/loading.svg" data-src="@(item.Logo == null || item.Logo.Length == 0 ? "/images/no_image.png" : item.Logo)" style="height:auto;  width:auto; max-height: 110px; max-width: 110px;display: block;margin-left: auto;margin-right: auto;" bc-thumbnail="true" bc-round="true" />
</a>
</td>
<td class="portal-col" data-col-type="thumb" data-col-key="Photo"><a href="@(item.Photo == null || item.Photo.Length == 0 ? "/images/no_image.png" : item.Photo)" data-toggle="lightbox" data-type="image" class="portal-list-thumb-link">
   <img class="lazyload img-fluid" src="/images/loading.svg" data-src="@(item.Photo == null || item.Photo.Length == 0 ? "/images/no_image.png" : item.Photo)" style="height:auto;  width:auto; max-height: 110px; max-width: 110px;display: block;margin-left: auto;margin-right: auto;" bc-thumbnail="true" bc-round="true" />
</a>
</td>
<td class="portal-col" data-col-type="file" data-col-key="BrandVideo">@if (!string.IsNullOrEmpty(item.BrandVideo))
{
    <a href="@item.BrandVideo" data-toggle="lightbox" data-type="video" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-file-video" aria-hidden="true"></i> Preview video
    </a>
}
else
{
    <span class="text-muted">-</span>
}
</td>
<td class="portal-col" data-col-type="file" data-col-key="CatalogPdf">@if (!string.IsNullOrEmpty(item.CatalogPdf))
{
    <a href="@item.CatalogPdf" data-toggle="lightbox" data-type="pdf" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-file-pdf" aria-hidden="true"></i> Preview PDF
    </a>
}
else
{
    <span class="text-muted">-</span>
}
</td>
<td class="portal-col" data-col-type="bool" data-col-key="IsActive">@if (item.IsActive == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsActive" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsActive" disabled />
    </div>
}
</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
