<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="theme-color" content="#3b488e">
    <link rel="icon" href="~/favicon.ico" sizes="48x48" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="48x48" href="~/img/favicons/favicon-48.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/img/favicons/favicon-96.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/favicons/favicon-192.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/favicons/apple-touch-icon.png" asp-append-version="true" />
    <title>@ViewData["Title"] - Demo Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-shell auth-shell--solo">
        <div class="auth-solo">
            <div id="qcErrorBrand" class="auth-solo__logo-mark">
                <img class="auth-solo__logo" src="/images/logo_s2.png" alt="Demo" />
            </div>
            @RenderBody()
            <a href="/Login" class="auth-btn">Return to sign in</a>
        </div>
    </main>
    <script src="/js/qc-brand-loader.js" asp-append-version="true"></script>
    <script>
    (function () {
        var host = document.getElementById('qcErrorBrand');
        if (host && window.QcBrandLoader) {
            window.QcBrandLoader.mount(host, { kind: 'logo', dark: false, once: true });
        }
    })();
    </script>
</body>
</html>
