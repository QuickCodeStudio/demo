Enum HttpMethodType {
  Get    [note: "Fetch data"]
  Post   [note: "Create or execute"]
  Put    [note: "Replace resource"]
  Delete [note: "Delete resource"]
  Patch  [note: "Partial update"]
}

Enum PageActionType {
  List    [note: "List page"]
  Detail  [note: "Details / view page"]
  Insert  [note: "Create page"]
  Update  [note: "Update page"]
  Delete  [note: "Delete page"]
}

Enum ModificationType {
  System [note: "Generated by system"]
  User   [note: "Defined manually by user"]
  UserDisabled [note: "Explicitly disabled by user"]
}

Enum ApiKeyStatus {
  Active
  Revoked
  Expired
}

Table "Modules" {
  "Name" varchar(1000) [pk, not null]
  "Description" varchar(1000) [not null]
   Note: '''
      Query:MODULE_NAME_IS_EXISTS[?] Where:Name
    '''
}

Table "Models" {
  "Name" varchar(1000) [pk, not null]
  "ModuleName" varchar(1000) [pk, not null]
  "Description" varchar(1000) [not null]
  Note: '''
    Query:MODULE_NAME_IS_EXISTS[?] Where:ModuleName
    Delete:DELETE_MODELS_WITH_MODULE_NAME Where:ModuleName
  '''
}

Table "PermissionGroups" {
  "Name" varchar(1000) [pk, not null]
  "Description" varchar(1000) [not null]
}

Table "ApiMethodDefinitions" {
   "Key" varchar(1000) [pk, not null]
   "ModuleName" varchar(1000) [not null]
   "ModelName" varchar(1000) [not null]
   "HttpMethod" HttpMethodType [not null]
   "ControllerName" varchar(1000) [not null]
   "MethodName" varchar(1000) [not null]
   "UrlPath" varchar(1000) [not null]
   Note: '''
        Query:GET_KAFKA_EVENTS_API_METHOD_DEFINITIONS[P] Tables:ApiMethodDefinitions A, KafkaEvents K Where:A.Key Select:K.*
        Query:GET_API_METHOD_DEFINITIONS_WITH_MODULE_NAME[] Where:ModuleName
        Query:GET_API_METHOD_DEFINITIONS_WITH_MODEL_NAME[] Where:ModelName
        Query:GET_API_METHOD_DEFINITIONS_BY_URL[] Where:UrlPath[StartsWith]
        Query:EXISTS_API_METHOD_DEFINITIONS_WITH_MODULE_NAME[?] Where:ModuleName
        Query:EXISTS_API_METHOD_DEFINITIONS_WITH_MODEL_NAME[?] Where:ModelName
        Delete:DELETE_API_METHOD_DEFINITIONS_WITH_MODULE_NAME Where:ModuleName
        Delete:DELETE_API_METHOD_DEFINITIONS_WITH_MODEL_NAME Where:ModelName
   '''
}

Table "PortalPageDefinitions" {
   "Key" varchar(1000) [pk, not null]
   "ModuleName" varchar(1000) [not null]
   "ModelName" varchar(1000) [not null]
   "PageAction" PageActionType [not null]
   "PagePath" varchar(1000) [not null]
   Note: '''
       Query:GET_PORTAL_PAGE_DEFINITIONS_WITH_MODULE_NAME[] Where:ModuleName
       Query:GET_PORTAL_PAGE_DEFINITIONS_WITH_MODEL_NAME[] Where:ModelName
       Query:GET_LIST_PORTAL_PAGE_DEFINITIONS[] Where:PageAction[Equals|List]
       Query:GET_PORTAL_PAGE_DEFINITIONS_BY_KEY[] Where:Key[StartsWith]
       Query:EXISTS_PORTAL_PAGE_DEFINITIONS_WITH_MODULE_NAME[?] Where:ModuleName
       Query:EXISTS_PORTAL_PAGE_DEFINITIONS_WITH_MODEL_NAME[?] Where:ModelName
       Delete:DELETE_PORTAL_PAGE_DEFINITIONS_WITH_MODULE_NAME Where:ModuleName
       Delete:DELETE_PORTAL_PAGE_DEFINITIONS_WITH_MODEL_NAME Where:ModelName
   '''
}

Table "ApiMethodAccessGrants" {
  "PermissionGroupName" varchar(1000) [pk, not null]
  "ApiMethodDefinitionKey" varchar(1000) [pk, not null]
  "ModifiedBy" ModificationType [not null, default: 'System']
  "IsActive" boolean [not null, default: '((0))']
  Note: '''
    Query:GET_API_METHOD_ACCESS_GRANT_NAMES[] Where:PermissionGroupName, IsActive[Equals|true]
    Query:GET_ACTIVE_API_METHOD_ACCESS_GRANTS[] Where:IsActive[Equals|true]
    Delete:CLEAR_API_METHOD_ACCESS_GRANTS Where:ModifiedBy[Equals|System]
    Insert:COPY_API_GRANTS Into:PermissionGroupName,ApiMethodDefinitionKey Tables:ApiMethodAccessGrants G, ApiMethodDefinitions A Where:G.PermissionGroupName,A.ModuleName Select:TargetPermissionGroupName,A.Key
  '''
}

Table "PortalPageAccessGrants" {
  "PermissionGroupName" varchar(1000) [pk, not null]
  "PortalPageDefinitionKey" varchar(1000) [pk, not null]
  "PageAction" PageActionType [pk, not null]
  "ModifiedBy" ModificationType [not null, default: 'System']
  "IsActive" boolean [not null, default: '((0))']
  Note: '''
    Query:GET_PORTAL_PAGE_ACCESS_GRANTS[] Where:PermissionGroupName, IsActive[Equals|true]
    Query:GET_PORTAL_PAGE_ACCESS_GRANT[] Where:PortalPageDefinitionKey, PermissionGroupName, PageAction, IsActive[Equals|true]
    Delete:CLEAR_PORTAL_PAGE_ACCESS_GRANTS Where:ModifiedBy[Equals|System]
  '''
}

Table "PortalMenu" {
  "Key" varchar(1000) [pk, not null]
  "Name" varchar(250) [not null]
  "Text" varchar(250) [not null]
  "Tooltip" varchar(250) [not null]
  "ActionName" varchar(250) [not null]
  "OrderNo" int [not null]
  "ParentName" varchar(250) 
  Note: '''
    Query:GET_PORTAL_MENUS[] Where:Key[StartsWith]
    Delete:DELETE_PORTAL_MENU_ITEMS_WITH_MODULE_NAME Where:Key[StartsWith]
    Delete:DELETE_PORTAL_MENU_ITEMS_WITH_MODEL_NAME Where:Key[StartsWith], Name
  '''
}

Table "ColumnTypes" {
  "Id" int [pk, not null, increment]
  "TypeName" varchar(250)
  "IosComponentName" varchar(250)
  "IosType" varchar(250)
  "IconCode" varchar(250)
}

Table "TableComboboxSettings" {
  "TableName" varchar(250) [pk, not null]
  "IdColumn" varchar(250)
  "TextColumns" varchar(max)
  "StringFormat" varchar(max)
}

Table "KafkaEvents" {
  "TopicName" varchar(1000) [pk, not null]
  "ApiMethodDefinitionKey" varchar(1000) [not null]
  "IsActive" boolean [not null, default: '((0))']
  Note: '''
    Query:GET_KAFKA_EVENTS[] Tables:KafkaEvents K, ApiMethodDefinitions A Select:K.*, A.HttpMethod, A.ControllerName, A.UrlPath
    Query:GET_ACTIVE_KAFKA_EVENTS[] Tables:KafkaEvents K, ApiMethodDefinitions A Where:K.IsActive[Equals|true] Select:K.*, A.HttpMethod, A.ControllerName, A.UrlPath
    Query:GET_TOPIC_WORKFLOWS[] Tables:TopicWorkflows T, KafkaEvents K, ApiMethodDefinitions A Where:K.IsActive[Equals|true], K.TopicName, A.HttpMethod  Select:T.*
    Query:GET_TOPIC_WORKFLOWS_KAFKA_EVENTS[P] Tables:KafkaEvents K, TopicWorkflows T Where:K.TopicName Select:T.*
    Delete:CLEAN_KAFKA_EVENTS_WITH_MODULE_NAME Tables: ApiMethodDefinitions A, KafkaEvents K Where: A.ModuleName
    Delete:CLEAN_KAFKA_EVENTS_WITH_MODEL_NAME Tables: ApiMethodDefinitions A, KafkaEvents K Where: A.ModelName
  '''
}

Table "TopicWorkflows" {
  "Id" int [pk, not null, increment]
  "KafkaEventsTopicName" varchar(1000) [not null]
  "WorkflowContent" yaml [not null]
  Note: '''
    Query:GET_WORKFLOWS[] Where:KafkaEventsTopicName
    Query:GET_WORKFLOWS2[] Where:KafkaEventsTopicName
    Query:GET_TOPIC_WORKFLOWS[] Tables:TopicWorkflows T, KafkaEvents K, ApiMethodDefinitions A Where:K.IsActive[Equals|true], K.TopicName, A.HttpMethod  Select:T.*
  '''
}

Table "EndpointWorkflows" {
  "Id" int [pk, not null, increment]
  "Name" varchar(500) [not null]
  "ModuleName" varchar(250) [not null]
  "EndpointPath" varchar(1000) [not null]
  "HttpMethod" varchar(20) [not null]
  "Description" varchar(max) [null]
  "WorkflowContent" yaml [not null]
  "RunOnBff" boolean [not null, default: '((0))']
  "IsActive" boolean [not null, default: '((0))']
  Note: '''
    Query:GET_ENDPOINT_WORKFLOWS[] Order:ModuleName,Name
    Query:GET_ACTIVE_ENDPOINT_WORKFLOWS[] Where:IsActive[Equals|true] Order:ModuleName,Name
    Update:SET_ACTIVE Where:Id Set:IsActive
  '''
}

Table "AspNetRoles" {
  "Id" nvarchar(450) [pk, not null]
  "Name" nvarchar(256)
  "NormalizedName" nvarchar(256) [null]
  "ConcurrencyStamp" nvarchar(MAX) [null]
}

Table "AspNetUsers" {
  "Id" nvarchar(450) [pk, not null]
  "FirstName" nvarchar(200) [null]
  "LastName" nvarchar(200) [null]
  "PermissionGroupName" varchar(1000) [not null]
  "UserName" nvarchar(256) [null]
  "NormalizedUserName" nvarchar(256) [null]
  "Email" nvarchar(256) [null]
  "NormalizedEmail" nvarchar(256) [null]
  "EmailConfirmed" bit [not null]
  "PasswordHash" nvarchar(MAX) [null]
  "SecurityStamp" nvarchar(MAX) [null]
  "ConcurrencyStamp" nvarchar(MAX) [null]
  "PhoneNumber" nvarchar(MAX) [null]
  "PhoneNumberConfirmed" bit [not null]
  "TwoFactorEnabled" bit [not null]
  "LockoutEnd" datetimeoffset [null]
  "LockoutEnabled" bit [not null]
  "AccessFailedCount" int [not null]
  "PhotoUrl" blob_image [not null, default: '']
  Note: '''
    Query:GET_USER[1] Where:Email
    Query:IDENTITY_USER_BY_ID[] Where:Id
    Query:IDENTITY_USER_BY_NORMALIZED_EMAIL[] Where:NormalizedEmail
    Query:IDENTITY_USER_BY_NORMALIZED_USERNAME[] Where:NormalizedUserName
    Query:GET_PHOTO[1] Where:Id Select:Id, PhotoUrl
    Update:UPDATE_PHOTO Where:Id Set:PhotoUrl
    Update:CLEAR_PHOTO Where:Id Set:PhotoUrl['']
  '''
}

Table "RefreshTokens" {
  "Id" int [pk, increment, not null]
  "UserId" nvarchar(450) [not null]
  "Token" nvarchar(500) [not null]
  "ExpiryDate" datetime [not null]
  "CreatedDate" datetime [not null, default: '(getdate())']
  "IsRevoked" boolean [not null, default: '((0))']
  Note: '''
    Query:GET_REFRESH_TOKEN[1] Where:Token, IsRevoked[Equals|false], ExpiryDate[>|Now]
    Update:UPDATE_REFRESH_TOKENS Where:Token[Equals] Set: IsRevoked[true]
  '''
}

Table "ApiKeys" {
  "Id" uuid [pk, not null]
  "Name" varchar(200) [unique, not null]
  "Description" varchar(1000) [null]
  "KeyPrefix" varchar(32) [not null]
  "KeyHash" varchar(128) [not null]
  "PermissionGroupName" varchar(1000) [not null, default: 'Admin']
  "CreatedByUserId" nvarchar(450) [null]
  "Status" ApiKeyStatus [not null, default: 'Active']
  "IsActive" boolean [not null, default: '((1))']
  "ExpiresAt" datetime [not null]
  "LastUsedAt" datetime [null]
  "CreatedDate" datetime [not null, default: '(getdate())']
  "RevokedDate" datetime [null]
  Note: '''
    Query:GET_API_KEY_BY_PREFIX[1] Where:KeyPrefix, IsActive[Equals|true], Status[Equals|Active]
    Query:API_KEY_NAME_IS_EXISTS[?] Where:Name
    Query:GET_BY_PREFIX[P] Where:KeyPrefix
    Query:GET_BY_NAME[P] Where:Name
    Query:GET_BY_STATUS[P] Where:Status
    Query:GET_BY_PERMISSION_GROUP[P] Where:PermissionGroupName
    Query:GET_ACTIVE[P] Where:IsActive[Equals|true], Status[Equals|Active]
    Update:REVOKE_API_KEY Where:Id Set:Status[Revoked], IsActive[false], RevokedDate[Now]
    Update:TOUCH_API_KEY_LAST_USED Where:Id Set:LastUsedAt[Now]
  '''
}

Table "ApiKeyUsageLogs" {
  "Id" int [pk, increment, not null]
  "ApiKeyId" uuid [not null]
  "HttpMethod" HttpMethodType [not null]
  "UrlPath" varchar(1000) [not null]
  "StatusCode" int [not null]
  "IpAddress" varchar(64) [null]
  "CreatedDate" datetime [not null, default: '(getdate())']
  Note: '''
    Query:GET_BY_API_KEY[P] Tables:ApiKeyUsageLogs L, ApiKeys K Where:L.ApiKeyId Select:L.*, K.Name, K.KeyPrefix, K.PermissionGroupName, K.Status
    Query:GET_BY_STATUS_CODE[P] Tables:ApiKeyUsageLogs L, ApiKeys K Where:L.StatusCode Select:L.*, K.Name, K.KeyPrefix, K.PermissionGroupName, K.Status
  '''
}

Table "AspNetRoleClaims" {
  "Id" int [pk, not null, increment]
  "RoleId" nvarchar(450) [not null]
  "ClaimType" nvarchar(MAX) [null]
  "ClaimValue" nvarchar(MAX) [null]
}

Table "AspNetUserClaims" {
  "Id" int [pk, not null, increment]
  "UserId" nvarchar(450) [not null]
  "ClaimType" nvarchar(MAX) [null]
  "ClaimValue" nvarchar(MAX) [null]
}

Table "AspNetUserLogins" {
  "LoginProvider" nvarchar(450) [pk, not null]
  "ProviderKey" nvarchar(450) [pk, not null]
  "ProviderDisplayName" nvarchar(MAX) [null]
  "UserId" nvarchar(450) [not null] 
}

Table "AspNetUserRoles" {
  "UserId" nvarchar(450) [pk, not null]
  "RoleId" nvarchar(450) [pk, not null]
}

Table "AspNetUserTokens" {
  "UserId" nvarchar(450) [pk, not null]
  "LoginProvider" nvarchar(450) [not null]
  "Name" nvarchar(450) [not null]
  "Value" nvarchar(MAX) [null]
}

Ref: "Models"."ModuleName" > "Modules"."Name"

Ref: "ApiMethodDefinitions"."ModuleName" > "Modules"."Name"
Ref: "ApiMethodDefinitions"."ModelName" > "Models"."Name"

Ref: "PortalPageDefinitions"."ModuleName" > "Modules"."Name"
Ref: "PortalPageDefinitions"."ModelName" > "Models"."Name"

Ref: "ApiMethodDefinitions"."Key" < "ApiMethodAccessGrants"."ApiMethodDefinitionKey"
Ref: "PortalPageDefinitions"."Key" < "PortalPageAccessGrants"."PortalPageDefinitionKey"
Ref: "PermissionGroups"."Name" < "ApiMethodAccessGrants"."PermissionGroupName"
Ref: "PermissionGroups"."Name" < "PortalPageAccessGrants"."PermissionGroupName"

Ref: "ApiMethodDefinitions"."Key" < "KafkaEvents"."ApiMethodDefinitionKey"
Ref: "KafkaEvents"."TopicName" < "TopicWorkflows"."KafkaEventsTopicName"

Ref: "PermissionGroups"."Name" < "AspNetUsers"."PermissionGroupName"
Ref: "AspNetUsers"."Id" < "RefreshTokens"."UserId"
Ref: "AspNetRoles"."Id" < "AspNetUserRoles"."RoleId"
Ref: "AspNetUsers"."Id" < "AspNetUserRoles"."UserId"
Ref: "AspNetRoles"."Id" < "AspNetRoleClaims"."RoleId"
Ref: "AspNetUsers"."Id" < "AspNetUserClaims"."UserId"
Ref: "AspNetUsers"."Id" < "AspNetUserLogins"."UserId"
Ref: "AspNetUsers"."Id" < "AspNetUserTokens"."UserId"

Ref: "PermissionGroups"."Name" < "ApiKeys"."PermissionGroupName"
Ref: "AspNetUsers"."Id" < "ApiKeys"."CreatedByUserId"
Ref: "ApiKeys"."Id" < "ApiKeyUsageLogs"."ApiKeyId"
