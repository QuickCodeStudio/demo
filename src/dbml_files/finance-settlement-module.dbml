Enum "PAYOUT_STATUS" {
  PENDING [note: "Payout calculated and awaiting approval"]
  APPROVED [note: "Payout approved and ready for processing"]
  PROCESSING [note: "Payout approved and sent to payment provider"]
  PAID [note: "Payout successfully transferred to the seller"]
  FAILED [note: "Payout transfer failed"]
  CANCELLED [note: "Payout cancelled by admin"]
}

Enum "TRANSACTION_TYPE" {
  SALE [note: "Revenue from a sale"]
  REFUND [note: "Deduction due to a customer refund"]
  COMMISSION [note: "Marketplace commission fee"]
  ADJUSTMENT_CREDIT [note: "A manual credit adjustment"]
  ADJUSTMENT_DEBIT [note: "A manual debit adjustment"]
  PAYOUT [note: "A withdrawal of funds by the seller"]
  CHARGEBACK [note: "Chargeback from payment processor"]
}

Enum "ADJUSTMENT_REASON" {
  SHIPPING_FEE [note: "Shipping fee adjustment"]
  MARKETING_BONUS [note: "Bonus for marketing participation"]
  DISPUTE_RESOLUTION [note: "Adjustment from a dispute resolution"]
  CHARGEBACK_REVERSAL [note: "Reversal of chargeback fee"]
  PLATFORM_ERROR [note: "Correction for platform error"]
  OTHER [note: "Other miscellaneous reason"]
}

Enum "COMMISSION_STATUS" {
  PENDING [note: "Commission calculated but not yet applied"]
  APPLIED [note: "Commission applied to seller balance"]
  PAID [note: "Commission included in payout"]
}

Table "PAYOUT_PERIODS" {
  "ID" INTEGER [pk, increment]
  "PERIOD_NAME" SHORT_STRING [not null]
  "START_DATE" DATETIME [not null]
  "END_DATE" DATETIME [not null]
  "IS_CLOSED" BOOLEAN [not null, default: 'false']
  "CLOSED_DATE" DATETIME
  "CREATED_DATE" DATETIME [not null]
  
  Note: '''
    Query:GET_OPEN_PERIOD[1] Where:IS_CLOSED[false] Order:START_DATE[Desc] Select:ID,PERIOD_NAME,START_DATE,END_DATE
    Query:GET_BY_DATE_RANGE[P] Where:START_DATE[Between] Select:ID,PERIOD_NAME,START_DATE,END_DATE,IS_CLOSED
    Query:GET_RECENT_PERIODS[P] Where:CREATED_DATE[>|NowRemoveDays90] Order:START_DATE[Desc] Select:ID,PERIOD_NAME,START_DATE,END_DATE,IS_CLOSED
    Query:GET_CLOSED_PERIODS[P] Where:IS_CLOSED[true] Order:END_DATE[Desc] Select:ID,PERIOD_NAME,START_DATE,END_DATE,CLOSED_DATE
    Update:CLOSE_PERIOD Where:ID Set:IS_CLOSED[true],CLOSED_DATE[Now]
  '''
}

Table "COMMISSION_MODELS" {
  "ID" INTEGER [pk, increment]
  "MODEL_NAME" STRING [not null]
  "DESCRIPTION" BIG_STRING
  "COMMISSION_PERCENTAGE" DECIMAL_18_8 [not null]
  "IS_ACTIVE" BOOLEAN [not null, default: 'true']
  "CREATED_DATE" DATETIME [not null]
  
  Note: '''
  Query:GET_ACTIVE[P] Where:IS_ACTIVE[true] Select:ID,MODEL_NAME,COMMISSION_PERCENTAGE
  Query:SEARCH_BY_NAME[P] Where:MODEL_NAME[Contains] Select:ID,MODEL_NAME,COMMISSION_PERCENTAGE,IS_ACTIVE
  Update:DEACTIVATE Where:ID Set:IS_ACTIVE[false]
  Update:UPDATE_PERCENTAGE Where:ID Set:COMMISSION_PERCENTAGE
'''
}

Table "COMMISSION_RULES" {
  "ID" INTEGER [pk, increment]
  "COMMISSION_MODEL_ID" INTEGER [not null]
  "RULE_NAME" STRING [not null]
  "MIN_ORDER_VALUE" MONEY
  "MAX_ORDER_VALUE" MONEY
  "OVERRIDE_PERCENTAGE" DECIMAL_18_8
  "IS_ACTIVE" BOOLEAN [not null, default: 'true']
  "CREATED_DATE" DATETIME [not null]
  
  Note: '''
    Query:GET_BY_MODEL_ID[P] Where:COMMISSION_MODEL_ID Select:ID,RULE_NAME,MIN_ORDER_VALUE,MAX_ORDER_VALUE,OVERRIDE_PERCENTAGE
    Query:GET_ACTIVE_RULES[P] Where:IS_ACTIVE[true] Order:CREATED_DATE[Desc] Select:ID,RULE_NAME,MIN_ORDER_VALUE,MAX_ORDER_VALUE,OVERRIDE_PERCENTAGE
    Query:GET_BY_VALUE_RANGE[P] Where:MIN_ORDER_VALUE,MAX_ORDER_VALUE Select:ID,RULE_NAME,OVERRIDE_PERCENTAGE
    Update:DEACTIVATE Where:ID Set:IS_ACTIVE[false]
    Update:UPDATE_RULE Where:ID Set:OVERRIDE_PERCENTAGE
  '''
}

Table "SELLER_PAYOUTS" {
  "ID" INTEGER [pk, increment]
  "SELLER_ID" INTEGER [not null]
  "PAYOUT_PERIOD_ID" INTEGER [not null]
  "TOTAL_EARNINGS" MONEY [not null]
  "TOTAL_COMMISSION" MONEY [not null]
  "TOTAL_ADJUSTMENTS" MONEY [not null, default: '0']
  "NET_PAYOUT_AMOUNT" MONEY [not null]
  "STATUS" PAYOUT_STATUS [not null, default: 'PENDING']
  "REQUESTED_DATE" DATETIME [not null]
  "APPROVED_DATE" DATETIME
  "PROCESSED_DATE" DATETIME
  "PAID_DATE" DATETIME
  "TRANSACTION_ID" SHORT_STRING
  "NOTES" BIG_STRING
  "CREATED_DATE" DATETIME [not null]
  
  Note: '''
    Query:GET_BY_SELLER_ID[P] Where:SELLER_ID Order:REQUESTED_DATE[Desc] Select:ID,NET_PAYOUT_AMOUNT,STATUS,REQUESTED_DATE,CREATED_DATE
    Query:GET_BY_STATUS[P] Where:STATUS Order:REQUESTED_DATE[Desc] Select:ID,SELLER_ID,NET_PAYOUT_AMOUNT,STATUS,REQUESTED_DATE
    Query:GET_WITH_PERIOD[P] Tables:SELLER_PAYOUTS SP,PAYOUT_PERIODS PP Where:SP.PAYOUT_PERIOD_ID Select:SP.ID,SP.SELLER_ID,SP.NET_PAYOUT_AMOUNT,SP.STATUS,PP.PERIOD_NAME,PP.START_DATE,PP.END_DATE
    Query:GET_PENDING_PAYOUTS[P] Where:STATUS[PENDING] Order:REQUESTED_DATE[Asc] Select:ID,SELLER_ID,NET_PAYOUT_AMOUNT,REQUESTED_DATE
    Query:GET_PENDING_PAYOUTS_SUMMARY[1] Where:STATUS[PENDING] Select:COUNT(*) COUNT,SUM(NET_PAYOUT_AMOUNT) TOTAL_AMOUNT
    Query:GET_APPROVED_PAYOUTS[P] Where:STATUS[APPROVED] Order:REQUESTED_DATE[Asc] Select:ID,SELLER_ID,NET_PAYOUT_AMOUNT,APPROVED_DATE
    Query:GET_PAID_SUMMARY[1] Where:STATUS[PAID],PAID_DATE[>|NowRemoveDays30] Select:COUNT(*) PAID_COUNT,SUM(NET_PAYOUT_AMOUNT) PAID_AMOUNT
    Query:GET_FAILED_PAYOUTS[P] Where:STATUS[FAILED] Order:PROCESSED_DATE[Desc] Select:ID,SELLER_ID,NET_PAYOUT_AMOUNT,PROCESSED_DATE,NOTES
    Query:GET_BY_PERIOD[P] Where:PAYOUT_PERIOD_ID Order:REQUESTED_DATE[Desc] Select:ID,SELLER_ID,NET_PAYOUT_AMOUNT,STATUS
    Update:APPROVE Where:ID Set:STATUS[APPROVED],APPROVED_DATE[Now]
    Update:MARK_AS_PROCESSING Where:ID Set:STATUS[PROCESSING]
    Update:MARK_AS_PAID Where:ID Set:STATUS[PAID],PAID_DATE[Now]
    Update:MARK_AS_FAILED Where:ID Set:STATUS[FAILED],PROCESSED_DATE[Now]
    Update:CANCEL Where:ID Set:STATUS[CANCELLED]
  '''
}

Table "PAYOUT_LINE_ITEMS" {
  "ID" INTEGER [pk, increment]
  "PAYOUT_ID" INTEGER [not null]
  "ORDER_ID" INTEGER [not null]
  "ORDER_ITEM_ID" INTEGER [not null]
  "ITEM_AMOUNT" MONEY [not null]
  "COMMISSION_AMOUNT" MONEY [not null]
  "ADJUSTMENT_AMOUNT" MONEY [not null, default: '0']
  "NET_AMOUNT" MONEY [not null]
  "CREATED_DATE" DATETIME [not null]
  
  Note: '''
    Query:GET_BY_PAYOUT_ID[P] Where:PAYOUT_ID Order:CREATED_DATE[Desc] Select:ID,ORDER_ID,ITEM_AMOUNT,COMMISSION_AMOUNT,ADJUSTMENT_AMOUNT,NET_AMOUNT
    Query:GET_BY_ORDER_ID[P] Where:ORDER_ID Select:ID,PAYOUT_ID,ITEM_AMOUNT,COMMISSION_AMOUNT,NET_AMOUNT
    Query:GET_TOTAL_BY_PAYOUT[1] Where:PAYOUT_ID Select:SUM(NET_AMOUNT) TOTAL_NET,SUM(COMMISSION_AMOUNT) TOTAL_COMMISSION,SUM(ADJUSTMENT_AMOUNT) TOTAL_ADJUSTMENTS
    Query:GET_HIGH_VALUE_ITEMS[P] Where:NET_AMOUNT[>|100] Order:NET_AMOUNT[Desc] Select:ID,PAYOUT_ID,ORDER_ID,ITEM_AMOUNT,NET_AMOUNT
  '''
}

Table "COMMISSION_ENTRIES" {
  "ID" INTEGER [pk, increment]
  "ORDER_ID" INTEGER [not null]
  "ORDER_ITEM_ID" INTEGER [not null]
  "SELLER_ID" INTEGER [not null]
  "COMMISSION_MODEL_ID" INTEGER [not null]
  "COMMISSION_RULE_ID" INTEGER [not null]
  "ITEM_PRICE" MONEY [not null]
  "COMMISSION_PERCENTAGE" DECIMAL_18_8 [not null]
  "COMMISSION_AMOUNT" MONEY [not null]
  "STATUS" COMMISSION_STATUS [not null, default: 'PENDING']
  "CALCULATED_DATE" DATETIME [not null]
  "APPLIED_DATE" DATETIME
  
  Note: '''
    Query:GET_BY_ORDER_ID[P] Where:ORDER_ID Select:ID,ORDER_ITEM_ID,COMMISSION_AMOUNT,COMMISSION_PERCENTAGE
    Query:GET_BY_SELLER_ID[P] Where:SELLER_ID Order:CALCULATED_DATE[Desc] Select:ID,ORDER_ID,COMMISSION_AMOUNT,CALCULATED_DATE
    Query:GET_RECENT_BY_SELLER[P] Where:SELLER_ID,CALCULATED_DATE[>|NowRemoveDays30] Select:ID,ORDER_ID,COMMISSION_AMOUNT,CALCULATED_DATE
    Query:GET_BY_STATUS[P] Where:STATUS Order:CALCULATED_DATE[Desc] Select:ID,SELLER_ID,ORDER_ID,COMMISSION_AMOUNT,STATUS
    Query:GET_PENDING_COMMISSIONS[P] Where:STATUS[PENDING] Order:CALCULATED_DATE[Asc] Select:ID,SELLER_ID,ORDER_ID,COMMISSION_AMOUNT
    Query:GET_TOTAL_BY_SELLER[1] Where:SELLER_ID,STATUS[PENDING] Select:SUM(COMMISSION_AMOUNT) TOTAL_PENDING
    Query:GET_BY_MODEL_AND_SELLER[P] Where:COMMISSION_MODEL_ID,SELLER_ID Order:CALCULATED_DATE[Desc] Select:ID,ORDER_ID,COMMISSION_AMOUNT
    Update:MARK_AS_APPLIED Where:ID Set:STATUS[APPLIED],APPLIED_DATE[Now]
    Update:MARK_AS_PAID Where:ID Set:STATUS[PAID]
  '''
}

Table "TRANSACTION_LEDGER" {
  "ID" INTEGER [pk, increment]
  "SELLER_ID" INTEGER [not null]
  "TRANSACTION_TYPE" TRANSACTION_TYPE [not null]
  "AMOUNT" MONEY [not null]
  "REFERENCE_ID" SHORT_STRING
  "REFERENCE_TYPE" SHORT_STRING
  "DESCRIPTION" BIG_STRING
  "TRANSACTION_DATE" DATETIME [not null]
  "CREATED_DATE" DATETIME [not null]
  
  Note: '''
    Query:GET_BY_SELLER_ID[P] Where:SELLER_ID Order:TRANSACTION_DATE[Desc] Select:ID,TRANSACTION_TYPE,AMOUNT,DESCRIPTION,TRANSACTION_DATE
    Query:GET_BY_TYPE[P] Where:TRANSACTION_TYPE Order:TRANSACTION_DATE[Desc] Select:ID,SELLER_ID,AMOUNT,DESCRIPTION,TRANSACTION_DATE
    Query:GET_SELLER_BALANCE[1] Where:SELLER_ID Select:SUM(AMOUNT) CURRENT_BALANCE
    Query:GET_TRANSACTIONS_BY_DATE_RANGE[P] Where:SELLER_ID,TRANSACTION_DATE[Between] Select:ID,TRANSACTION_TYPE,AMOUNT,DESCRIPTION,TRANSACTION_DATE
    Query:GET_RECENT_TRANSACTIONS[P] Where:SELLER_ID,TRANSACTION_DATE[>|NowRemoveDays7] Order:TRANSACTION_DATE[Desc] Select:ID,TRANSACTION_TYPE,AMOUNT,TRANSACTION_DATE
    Query:GET_DAILY_SUMMARY[1] Where:SELLER_ID,TRANSACTION_DATE[>|NowRemoveDays1] Select:COUNT(*) TRANSACTION_COUNT,SUM(AMOUNT) DAILY_TOTAL
    Query:GET_BY_REFERENCE[P] Where:REFERENCE_ID Select:ID,SELLER_ID,TRANSACTION_TYPE,AMOUNT,TRANSACTION_DATE
    Query:GET_SALES_TOTAL[1] Where:SELLER_ID,TRANSACTION_TYPE[SALE] Select:SUM(AMOUNT) TOTAL_SALES
    Query:GET_REFUNDS_TOTAL[1] Where:SELLER_ID,TRANSACTION_TYPE[REFUND] Select:SUM(AMOUNT) TOTAL_REFUNDS
    Update:ADD_TRANSACTION Where:ID Set:DESCRIPTION
  '''
}

Table "FINANCIAL_ADJUSTMENTS" {
  "ID" INTEGER [pk, increment]
  "SELLER_ID" INTEGER [not null]
  "PAYOUT_ID" INTEGER
  "AMOUNT" MONEY [not null]
  "REASON" ADJUSTMENT_REASON [not null]
  "NOTES" BIG_STRING
  "CREATED_BY_USER_ID" INTEGER [not null]
  "APPROVED_BY_USER_ID" INTEGER
  "CREATED_DATE" DATETIME [not null]
  "APPROVED_DATE" DATETIME
  "IS_ACTIVE" BOOLEAN [not null, default: 'true']
  
  Note: '''
    Query:GET_BY_SELLER_ID[P] Where:SELLER_ID Order:CREATED_DATE[Desc] Select:ID,AMOUNT,REASON,NOTES,CREATED_DATE
    Query:GET_BY_REASON[P] Where:REASON Order:CREATED_DATE[Desc] Select:ID,SELLER_ID,AMOUNT,REASON,CREATED_DATE
    Query:GET_TOTAL_BY_SELLER[1] Where:SELLER_ID Select:SUM(AMOUNT) TOTAL_ADJUSTMENTS
    Query:GET_RECENT_ADJUSTMENTS[P] Where:CREATED_DATE[>|NowRemoveDays30] Order:CREATED_DATE[Desc] Select:ID,SELLER_ID,AMOUNT,REASON
    Query:GET_PENDING_APPROVAL[P] Where:APPROVED_BY_USER_ID[IS NULL] Order:CREATED_DATE[Asc] Select:ID,SELLER_ID,AMOUNT,REASON,CREATED_DATE
    Query:GET_BY_PAYOUT[P] Where:PAYOUT_ID Select:ID,SELLER_ID,AMOUNT,REASON,CREATED_DATE
    Query:GET_ACTIVE_ADJUSTMENTS[P] Where:IS_ACTIVE[true] Order:CREATED_DATE[Desc] Select:ID,SELLER_ID,AMOUNT,REASON
    Update:APPROVE Where:ID Set:APPROVED_BY_USER_ID,APPROVED_DATE[Now]
    Update:DEACTIVATE Where:ID Set:IS_ACTIVE[false]
  '''
}

Table "PAYOUT_REPORTS" {
  "ID" INTEGER [pk, increment]
  "PAYOUT_PERIOD_ID" INTEGER [not null]
  "TOTAL_SELLERS" INTEGER [not null]
  "TOTAL_PAYOUTS" INTEGER [not null]
  "TOTAL_AMOUNT" MONEY [not null]
  "SUCCESSFUL_PAYOUTS" INTEGER [not null]
  "FAILED_PAYOUTS" INTEGER [not null]
  "PENDING_PAYOUTS" INTEGER [not null]
  "GENERATED_DATE" DATETIME [not null]
  
  Note: '''
    Query:GET_BY_PERIOD[P] Where:PAYOUT_PERIOD_ID Select:ID,TOTAL_SELLERS,TOTAL_PAYOUTS,TOTAL_AMOUNT,SUCCESSFUL_PAYOUTS,FAILED_PAYOUTS
    Query:GET_RECENT_REPORTS[P] Where:GENERATED_DATE[>|NowRemoveDays90] Order:GENERATED_DATE[Desc] Select:ID,PAYOUT_PERIOD_ID,TOTAL_AMOUNT,SUCCESSFUL_PAYOUTS,FAILED_PAYOUTS
    Query:GET_LATEST_REPORT[1] Order:GENERATED_DATE[Desc] Select:ID,PAYOUT_PERIOD_ID,TOTAL_AMOUNT,SUCCESSFUL_PAYOUTS,FAILED_PAYOUTS,GENERATED_DATE
  '''
}

Ref: "SELLER_PAYOUTS"."PAYOUT_PERIOD_ID" > "PAYOUT_PERIODS"."ID"
Ref: "PAYOUT_LINE_ITEMS"."PAYOUT_ID" > "SELLER_PAYOUTS"."ID"
Ref: "COMMISSION_RULES"."COMMISSION_MODEL_ID" > "COMMISSION_MODELS"."ID"
Ref: "PAYOUT_REPORTS"."PAYOUT_PERIOD_ID" > "PAYOUT_PERIODS"."ID"